# 이 파일을 복사해서 같은 위치에 .env.local 로 저장한 뒤 실제 값을 채워넣으세요.
# .env.local은 .gitignore에 의해 커밋되지 않습니다. Vite가 자동으로 읽어서
# import.meta.env.VITE_GOOGLE_CLIENT_ID / VITE_KAKAO_JS_KEY로 노출합니다.

VITE_GOOGLE_CLIENT_ID=

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키의 "JavaScript 키"를 넣으세요.
# (REST API 키/Admin 키 아님 — 카카오 로그인 JS SDK가 요구하는 건 JavaScript 키입니다.)
VITE_KAKAO_JS_KEY=
